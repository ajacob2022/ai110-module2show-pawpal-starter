classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet)
        +get_all_tasks() list~Pet_Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task)
        +remove_task(description)
    }

    class Task {
        +str description
        +int duration_minutes
        +str time
        +str frequency
        +str priority
        +bool completed
        +date due_date
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +sort_by_time(pairs) list~Pet_Task~
        +filter_tasks(pet_name, completed) list~Pet_Task~
        +mark_task_complete(pet, task)
        +detect_conflicts() list~str~
        +build_plan() list~Pet_Task~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
